# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# RPC endpoints
ARB_RPC=https://arb1.arbitrum.io/rpc
BSC_RPC=https://bsc-dataseed.binance.org/
BASE_RPC=https://mainnet.base.org

# Health Factor thresholds (настраиваемые)
HF_ALERT_THRESHOLD=1.05       # Уведомлять когда HF ниже этого значения
HF_CRITICAL_THRESHOLD=1.01    # Критическое предупреждение

# Мониторинг интервал (секунды)
SCAN_INTERVAL=60

# Минимальная сумма позиции в USD (чтобы фильтровать пыль)
MIN_POSITION_USD=1000

# Кулдаун для повторных уведомлений (минуты)
ALERT_COOLDOWN_MINUTES=10

# Максимальное количество блоков для поиска заёмщиков при старте
MAX_BLOCKS_SCAN=50000

# Максимальный диапазон блоков в одном запросе eth_getLogs (предотвращает ошибку 413 на публичных RPC)
LOG_CHUNK_SIZE=2000
